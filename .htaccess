RewriteEngine On

# Redirect www to non-www
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

# Redirect sitemap.xm -> sitemap.xml (typo fix)
RewriteCond %{REQUEST_URI} ^/sitemap\.xm$ [NC]
RewriteRule ^sitemap\.xm$ sitemap.xml [R=301,L]


RewriteEngine On
RewriteBase /

# Force UTF-8
AddDefaultCharset UTF-8

# Кастомная страница для 410 (чтобы показывался наш шаблон с хедером)
ErrorDocument 410 /gone

# Временно: отдаём 410 Gone для мусорных страниц вида *.html,
# чтобы они не попадали в роутер. Если вдруг на диске реально есть .html-файл,
# он будет отдаваться как файл (без 410).
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^.+\.html$ - [G,L]

# Убираем trailing slash (кроме корня)
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} ^(.+)/$
RewriteRule ^ %1 [R=301,L]

# Auto-prepend bootstrap для автозагрузки ядра во всех PHP-файлах (кроме api.php и upload.php)
<FilesMatch "^(?!api\.php$|upload\.php$).*\.php$">
    php_value auto_prepend_file "core/bootstrap.php"
</FilesMatch>

# Clean URLs routing
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.+)$ index.php [QSA,L]

# Allow direct access to assets
<FilesMatch "\.(css|js|png|jpg|jpeg|gif|svg|webp)$">
    Header set Cache-Control "public, max-age=31536000"
</FilesMatch>
